# The pinned QEMU oracle configuration (corpus id `qemu-oracle`).
#
# Copy to tools/oracle/qemu-oracle.env and fill in the local paths. The copy is not committed:
# it names paths under the preserved data root, which is outside this repository.
#
# The flags are the measured configuration:
# -icount shift=0,align=off,sleep=off. `-icount 3` was measured and rejected.

# The patched build of the Espressif QEMU, through the wrapper.
PEMU_QEMU_BIN=
# Pinned SHA-256 prefix of that binary, checked before a run.
PEMU_QEMU_SHA256_PREFIX=eb28ffc878f8b2d2

# ROM directory QEMU is pointed at with -L, and the ROM image file itself. Both are needed:
# -L takes the directory, and the pin is a hash of the file (rev101-lma/esp32c3-rom.bin), which
# the script computes and records in every golden header.
PEMU_QEMU_ROM_DIR=
PEMU_QEMU_ROM=
PEMU_QEMU_ROM_SHA256_PREFIX=8b41b9b114e110e3

# Synthesized eFuse image (chip v1.1, block v1.3) and its pinned SHA-256 prefix.
PEMU_QEMU_EFUSE=
PEMU_QEMU_EFUSE_SHA256_PREFIX=555952c9daccdf75

# Strap value the run overrides. UNVERIFIED; every console difference it causes is
# a listed entry in specs/oracle-known-diffs.toml, never a silent mask. The script passes it as
#   -global driver=$PEMU_QEMU_STRAP_DRIVER,property=$PEMU_QEMU_STRAP_PROPERTY,value=$PEMU_QEMU_STRAP_MODE
# The device and property names below are UNVERIFIED for this QEMU build: if it rejects the
# option the run fails rather than quietly booting with default straps, and the two names are
# then corrected here, not in the script.
PEMU_QEMU_STRAP_MODE=0x0A
PEMU_QEMU_STRAP_DRIVER=esp32c3.gpio
PEMU_QEMU_STRAP_PROPERTY=strap_mode

# Fixed flags. Keep them in one place so a golden header records exactly what ran.
PEMU_QEMU_FLAGS="-M esp32c3 -display none -monitor none -icount shift=0,align=off,sleep=off"
PEMU_QEMU_TRACE_FLAGS="-d trace:memory_region_ops_read,trace:memory_region_ops_write"

# Where the run writes. Point it at the preserved data root, never into this repository.
PEMU_ORACLE_OUT=

# The oracle's wrapper launcher, optional. It exports the DYLD_LIBRARY_PATH the preserved
# Homebrew bottles need and then execs $QEMU_BIN, which a SIP-protected launcher would otherwise
# strip. Leave it empty to start PEMU_QEMU_BIN directly. The pin above is checked against
# PEMU_QEMU_BIN either way, so the header always records the hash of the binary that ran.
PEMU_QEMU_LAUNCHER=

# Images to regenerate a console for: **one `id=path` pair per line**, because the data root
# lives under "Application Support" and every path holds a space (pk, official, goldminer, the
# flipped copy and the probes). For example:
#   PEMU_ORACLE_IMAGES="pk=$HOME/Library/Application Support/passportsim/corpus/pk/x.bin
#   official=$HOME/Library/Application Support/passportsim/corpus/official/y.bin"
# `cargo xtask oracle consoles` writes this file for you; --print shows what it resolved.
PEMU_ORACLE_IMAGES=""
