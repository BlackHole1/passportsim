# probe_campaign_timing overrides on top of probes/common/sdkconfig.defaults, for the silicon
# evidence campaign (specs/notes/silicon-campaign.md).
#
# 1. The partition table is the Passport's own layout (partitions.csv beside this file), so the
#    identity guard accepts a flash of this image and no segment falls in cardid; the probe writes
#    no flash and initialises no NVS.
# 2. Hardware AES is pinned on, as probe_crypto pins it, so a change of default cannot move the
#    AES step onto software.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_MBEDTLS_HARDWARE_AES=y
CONFIG_MBEDTLS_AES_USE_INTERRUPT=y
