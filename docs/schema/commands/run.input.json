{
  "additionalProperties": false,
  "description": "`run` arguments.",
  "properties": {
    "fail_if": {
      "description": "Matchers that fail the run.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "for": {
      "description": "Duration to advance.",
      "oneOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "pattern": "^[0-9]+(\\.[0-9]+)?(us|ms|s|m)$",
          "type": "string"
        }
      ]
    },
    "instance": {
      "description": "Instance id.",
      "pattern": "^[pb][0-9]+$",
      "type": "string"
    },
    "stream": {
      "description": "Console (usj).",
      "enum": [
        "usj",
        "uart0"
      ],
      "type": "string"
    },
    "timeout": {
      "description": "Timeout, 10s.",
      "oneOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "pattern": "^[0-9]+(\\.[0-9]+)?(us|ms|s|m)$",
          "type": "string"
        }
      ]
    },
    "until": {
      "description": "Matcher.",
      "type": "string"
    },
    "wall_budget_ms": {
      "description": "Host budget in ms (30000).",
      "minimum": 100,
      "type": "integer"
    }
  },
  "type": "object"
}
