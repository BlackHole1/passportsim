{
  "additionalProperties": false,
  "description": "`env` arguments; at least one part of the world is required.",
  "properties": {
    "battery": {
      "additionalProperties": false,
      "description": "Fuel-gauge values; each field is optional on its own.",
      "properties": {
        "mv": {
          "maximum": 4400,
          "minimum": 2500,
          "type": "integer"
        },
        "present": {
          "type": "boolean"
        },
        "soc": {
          "maximum": 100,
          "minimum": 0,
          "type": "integer"
        },
        "temp_c": {
          "maximum": 80,
          "minimum": -20,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "ble_bridge": {
      "description": "The external HCI bridge: attach opens a loopback transport a peer connects to and diverts the guest's HCI packets to it; detach gives the guest back to the virtual controller. While it is attached the clock is held at realtime 1.000x.",
      "enum": [
        "attach",
        "detach"
      ],
      "type": "string"
    },
    "instance": {
      "description": "Instance id.",
      "pattern": "^[pb][0-9]+$",
      "type": "string"
    },
    "mic": {
      "additionalProperties": false,
      "description": "Microphone source.",
      "properties": {
        "amplitude": {
          "maximum": 32767,
          "minimum": 0,
          "type": "integer"
        },
        "hz": {
          "maximum": 8000,
          "minimum": 1,
          "type": "integer"
        },
        "kind": {
          "enum": [
            "silence",
            "tone",
            "file",
            "live"
          ],
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "nfc": {
      "additionalProperties": false,
      "description": "Whether a card sits in the reader field.",
      "properties": {
        "card_present": {
          "type": "boolean"
        }
      },
      "required": [
        "card_present"
      ],
      "type": "object"
    },
    "usb": {
      "description": "USB world state.",
      "enum": [
        "unplugged",
        "charger",
        "host",
        "open"
      ],
      "type": "string"
    },
    "wifi": {
      "additionalProperties": false,
      "description": "The scripted access points a Wi-Fi scan finds; replaces the set before.",
      "properties": {
        "aps": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "auth": {
                "maximum": 10,
                "minimum": 0,
                "type": "integer"
              },
              "bssid": {
                "description": "Six hex octets; scripted ones start 02:00:00.",
                "type": "string"
              },
              "channel": {
                "maximum": 11,
                "minimum": 1,
                "type": "integer"
              },
              "psk": {
                "description": "Secret input for a secured network: 6 to 64 bytes and not one repeated byte, so the secret set can hold it; never echoed back, and never written into a journal export.",
                "maxLength": 64,
                "minLength": 6,
                "type": "string"
              },
              "rssi": {
                "maximum": 0,
                "minimum": -127,
                "type": "integer"
              },
              "ssid": {
                "maxLength": 32,
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "ssid",
              "bssid",
              "rssi",
              "channel",
              "auth"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "aps"
      ],
      "type": "object"
    }
  },
  "type": "object"
}
